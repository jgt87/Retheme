# Python
__pycache__/
# NB: do NOT ignore *.pyd here — they are compiled C-extension modules that the
# bundled runtime in dist/ needs. Only ignore bytecode.
*.py[co]
*.egg-info/
.eggs/
# Anchored to repo root so these don't match the bundled stdlib's Lib/venv/ etc.
/.venv/
/venv/
/env/

# Testing
.pytest_cache/
.coverage
htmlcov/

# PyInstaller intermediate build output (dist/ is committed for distribution)
build/

# Scratch / working files
temp/

# Generated demo outputs (regenerable from the input examples)
examples/demo-branded.pptx
examples/demo-branded.html

# Tooling
.impeccable/
.claude/settings.local.json

# OS
Thumbs.db
Desktop.ini
.DS_Store
